---
// A plain disclosure for a worked answer that sits in prose rather than
// inside one of the three graded widgets. Native <details>/<summary>:
// no script, no state to get wrong, and it still reads as "choose or think
// first, then reveal" rather than handing the answer over immediately.
interface Props {
  summary?: string;
}

const { summary = "Show the answer" } = Astro.props;
---

<details class="answer-reveal">
  <summary class="answer-reveal-summary">{summary}</summary>
  <div class="answer-reveal-body">
    <slot />
  </div>
</details>

<style>
  .answer-reveal {
    margin-block: 1rem;
    padding: 0.75rem 1rem;
    border: 1px solid var(--at-border);
    border-radius: var(--at-border-radius);
    background: var(--at-bg-alt);
  }

  .answer-reveal-summary {
    color: var(--at-text);
    font-family: var(--at-font-mono);
    font-size: var(--at-font-size-sm);
    cursor: pointer;
  }

  .answer-reveal[open] .answer-reveal-summary {
    margin-block-end: 0.75rem;
  }

  .answer-reveal-body > :first-child {
    margin-block-start: 0;
  }

  .answer-reveal-body > :last-child {
    margin-block-end: 0;
  }
</style>
