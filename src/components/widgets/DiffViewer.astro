---
// Widget 2 — Diff Viewer. Supports week 6 (The Diff).
//
// Diffs one specific, real pair: the syllabus as it was first published
// (thirteen weeks, forensic versioning and provenance as separate weeks) and
// the syllabus as it stands (twelve weeks, the two merged). That revision is
// already declared in the syllabus version header, so this makes the claim
// inspectable rather than asserting it a second time.
//
// The diff is computed here, at build time, by the same longest-common-
// subsequence method the lecture describes. Nothing is hand-marked, so the
// widget cannot drift out of agreement with the two texts it is given.

const versionA = [
  "Week 1: final_FINAL_revised2",
  "Week 2: What Is a File?",
  "Week 3: Copies & Clones",
  "Week 4: Save As",
  "Week 5: Before Git",
  "Week 6: The Diff",
  "Week 7: Merge Conflict",
  "Week 8: The Canonical Version",
  "Week 9: Sync Is a Lie",
  "Week 10: Conversion Damage",
  "Week 11: Forensic Versioning",
  "Week 12: Provenance & Archives",
  "Week 13: Archive or Delete?",
];

const versionB = [
  "Week 1: final_FINAL_revised2",
  "Week 2: What Is a File?",
  "Week 3: Copies & Clones",
  "Week 4: Save As",
  "Week 5: Before Git",
  "Week 6: The Diff",
  "Week 7: Merge Conflict",
  "Week 8: The Canonical Version",
  "Week 9: Sync Is a Lie",
  "Week 10: Conversion Damage",
  "Week 11: Provenance & Forensics",
  "Week 12: Archive or Delete?",
];

type Op = "keep" | "add" | "remove";
interface DiffLine {
  op: Op;
  text: string;
}

// Longest common subsequence, then walk it back into a line-level diff.
// Deliberately the textbook version: the point of the widget is that this is
// all a diff is.
function diffLines(a: string[], b: string[]): DiffLine[] {
  const lcs: number[][] = Array.from({ length: a.length + 1 }, () =>
    new Array<number>(b.length + 1).fill(0),
  );

  for (let i = a.length - 1; i >= 0; i -= 1) {
    for (let j = b.length - 1; j >= 0; j -= 1) {
      lcs[i][j] = a[i] === b[j] ? lcs[i + 1][j + 1] + 1 : Math.max(lcs[i + 1][j], lcs[i][j + 1]);
    }
  }

  const result: DiffLine[] = [];
  let i = 0;
  let j = 0;
  while (i < a.length && j < b.length) {
    if (a[i] === b[j]) {
      result.push({ op: "keep", text: a[i] });
      i += 1;
      j += 1;
    } else if (lcs[i + 1][j] >= lcs[i][j + 1]) {
      result.push({ op: "remove", text: a[i] });
      i += 1;
    } else {
      result.push({ op: "add", text: b[j] });
      j += 1;
    }
  }
  while (i < a.length) {
    result.push({ op: "remove", text: a[i] });
    i += 1;
  }
  while (j < b.length) {
    result.push({ op: "add", text: b[j] });
    j += 1;
  }
  return result;
}

const diff = diffLines(versionA, versionB);
const removed = diff.filter((line) => line.op === "remove").length;
const added = diff.filter((line) => line.op === "add").length;
const marker: Record<Op, string> = { keep: " ", add: "+", remove: "−" };
const opLabel: Record<Op, string> = { keep: "unchanged", add: "added", remove: "removed" };
---

<section class="diff-viewer" aria-labelledby="diff-viewer-heading">
  <h3 id="diff-viewer-heading">Syllabus, v1.0 against v2.0</h3>
  <p class="diff-viewer-note">
    The week list as first published, and as it stands now. Switch between the
    two versions and the difference between them. The comparison is computed
    from the two lists by the method described in the lecture. No line is
    marked by hand.
  </p>

  <div class="diff-viewer-controls" role="group" aria-label="Choose a view">
    <button type="button" data-diff-view="a" aria-pressed="false">Version 1.0</button>
    <button type="button" data-diff-view="b" aria-pressed="false">Version 2.0</button>
    <button type="button" data-diff-view="diff" aria-pressed="true">Difference</button>
  </div>

  <p class="diff-viewer-summary" data-diff-summary aria-live="polite">
    {removed} line{removed === 1 ? "" : "s"} removed, {added} added.
  </p>

  <ol class="diff-viewer-lines" data-diff-lines>
    {
      diff.map((line) => (
        <li class:list={["diff-line", `diff-line--${line.op}`]} data-op={line.op}>
          <span class="diff-line-marker" aria-hidden="true">
            {marker[line.op]}
          </span>
          <span class="visually-hidden">{opLabel[line.op]}: </span>
          <span class="diff-line-text">{line.text}</span>
        </li>
      ))
    }
  </ol>

  <p class="diff-viewer-note">
    Three lines removed and two added, for a revision a person would describe
    in one clause: two weeks were merged into one. The comparison cannot say
    that. It also cannot say that <em>Archive or Delete?</em> did not change:
    that week was renumbered from 13 to 12, and a renumbered line is a
    different line, so the diff reports it as a deletion and an addition. One
    of the five differences below is not a difference. Nothing in the output
    distinguishes it from the ones that are.
  </p>
</section>

<script>
  function initDiffViewers() {
    for (const viewer of document.querySelectorAll<HTMLElement>(".diff-viewer")) {
      if (viewer.dataset.diffReady === "true") continue;
      viewer.dataset.diffReady = "true";

      const buttons = viewer.querySelectorAll<HTMLButtonElement>("[data-diff-view]");
      const lines = viewer.querySelectorAll<HTMLElement>(".diff-line");
      const summary = viewer.querySelector<HTMLElement>("[data-diff-summary]");

      const counts = { remove: 0, add: 0 };
      for (const line of lines) {
        if (line.dataset.op === "remove") counts.remove += 1;
        if (line.dataset.op === "add") counts.add += 1;
      }

      const plural = (n: number) => (n === 1 ? "" : "s");
      const summaries: Record<string, string> = {
        a: `Version 1.0: ${lines.length - counts.add} line${plural(lines.length - counts.add)}.`,
        b: `Version 2.0: ${lines.length - counts.remove} line${plural(lines.length - counts.remove)}.`,
        diff: `${counts.remove} line${plural(counts.remove)} removed, ${counts.add} added.`,
      };

      const show = (view: string) => {
        for (const line of lines) {
          const op = line.dataset.op ?? "keep";
          const visible =
            view === "diff" ||
            (view === "a" && op !== "add") ||
            (view === "b" && op !== "remove");
          line.hidden = !visible;
          line.classList.toggle("diff-line--plain", view !== "diff");
        }
        for (const button of buttons) {
          button.setAttribute("aria-pressed", String(button.dataset.diffView === view));
        }
        if (summary) summary.textContent = summaries[view] ?? "";
      };

      for (const button of buttons) {
        button.addEventListener("click", () => show(button.dataset.diffView ?? "diff"));
      }
    }
  }

  initDiffViewers();
  document.addEventListener("astro:page-load", initDiffViewers);
</script>

<style>
  .diff-viewer {
    margin-block: 2rem;
    padding: 1.25rem;
    border: 1px solid var(--at-border);
    border-radius: var(--at-border-radius);
    background: var(--at-bg-alt);
  }

  .diff-viewer h3 {
    margin-block: 0 0.75rem;
  }

  .diff-viewer-note {
    margin-block: 0.75rem;
    color: var(--at-text-secondary);
    font-size: var(--at-font-size-sm);
  }

  .diff-viewer-controls {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-block: 1rem 0.75rem;
  }

  .diff-viewer-controls button {
    padding: 0.35rem 0.85rem;
    border: 1px solid var(--at-border);
    border-radius: var(--at-border-radius);
    background: var(--at-bg);
    color: var(--at-text);
    font-family: var(--at-font-mono);
    font-size: var(--at-font-size-sm);
    cursor: pointer;
  }

  .diff-viewer-controls button:hover {
    border-color: var(--at-primary);
  }

  .diff-viewer-controls button[aria-pressed="true"] {
    border-color: var(--at-primary);
    background: var(--at-primary-tint, var(--at-bg-elevated));
    font-weight: 600;
  }

  .diff-viewer-summary {
    margin-block: 0 0.75rem;
    color: var(--at-text-secondary);
    font-family: var(--at-font-mono);
    font-size: var(--at-font-size-xs);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .diff-viewer-lines {
    margin: 0;
    padding: 0.5rem 0;
    border: 1px solid var(--at-divider);
    border-radius: var(--at-border-radius);
    background: var(--at-bg);
    list-style: none;
    overflow-x: auto;
  }

  .diff-line {
    display: flex;
    gap: 0.75rem;
    padding: 0.15rem 0.85rem;
    font-family: var(--at-font-mono);
    font-size: var(--at-font-size-sm);
    white-space: nowrap;
  }

  .diff-line[hidden] {
    display: none;
  }

  .diff-line-marker {
    flex: none;
    width: 1ch;
    font-weight: 700;
  }

  .diff-line--add {
    background: var(--at-success-soft);
  }

  .diff-line--add .diff-line-marker {
    color: var(--at-success);
  }

  .diff-line--remove {
    background: var(--at-error-soft);
    text-decoration: line-through;
    text-decoration-thickness: 1px;
  }

  .diff-line--remove .diff-line-marker {
    color: var(--at-error);
    text-decoration: none;
  }

  .diff-line--plain {
    background: none;
    text-decoration: none;
  }

  .diff-line--plain .diff-line-marker {
    visibility: hidden;
  }
</style>
